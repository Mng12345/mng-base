{
  "name": "mng-base",
  "version": "1.3.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mng12345/mng-base.git"
  },
  "homepage": "https://github.com/Mng12345/mng-base",
  "license": "MIT",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./option": {
      "types": "./dist/esm/option.d.ts",
      "import": "./dist/esm/option.js",
      "require": "./dist/cjs/option.js"
    },
    "./result": {
      "types": "./dist/esm/result.d.ts",
      "import": "./dist/esm/result.js",
      "require": "./dist/cjs/result.js"
    },
    "./types": {
      "types": "./dist/esm/types.d.ts",
      "import": "./dist/esm/types.js",
      "require": "./dist/cjs/types.js"
    }
  },
  "files": [
    "dist",
    "readme.md"
  ],
  "scripts": {
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build:esm": "tsc --project tsconfig.esm.json",
    "build": "rimraf dist & pnpm build:cjs & pnpm build:esm",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.25",
    "globby": "^15.0.0",
    "jest": "^29.7.0",
    "mng-base": "^1.3.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}